{
  "name": "dawn-kingdom",
  "version": "0.10.0",
  "private": true,
  "description": "새벽의 왕국 — 브라우저에서 돌아가는 아이소메트릭 실시간 전략 게임",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:src": "DAWN_TARGET=src node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "serve": "npx --yes http-server dist -p 8080 -c-1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": { "node": ">=20" }
}
